{
  "version": 2,
  "name": "investment-advisor-web",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/apps/web/dist/$1"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": ""
  },
  "buildCommand": "cd apps/web && npm install --install-strategy=shallow && npm run build",
  "outputDirectory": "apps/web/dist"
}
